[
  // ============================================
  // Global keybindings
  // ============================================
  {
    "context": "Workspace",
    "bindings": {
      // Pane navigation shared with Neovim and VS Code
      "alt-h": "workspace::ActivatePaneLeft",
      "alt-j": "workspace::ActivatePaneDown",
      "alt-k": "workspace::ActivatePaneUp",
      "alt-l": "workspace::ActivatePaneRight",
      // Tab navigation shared with Kitty
      "alt-n": "pane::ActivateNextItem",
      "alt-p": "pane::ActivatePreviousItem",
      "alt-x": "pane::CloseActiveItem",
    },
  },
  {
    // Space is a leader only in Normal mode and the non-editing file tree.
    // Never register printable prefixes globally: they delay terminal input.
    "context": "(Editor && mode == full && vim_mode == normal && !menu) || (ProjectPanel && not_editing)",
    "bindings": {
      // Window split
      "space w v": "pane::SplitRight",
      "space w h": "pane::SplitDown",
      // File explorer
      "space e e": "workspace::ToggleLeftDock",
      // Find
      "space f f": "file_finder::Toggle",
      "space f p": "projects::OpenRecent",
      "space f g": "pane::DeploySearch",
      "space f b": "tab_switcher::Toggle",
      "space f w": "project_symbols::Toggle",
      "space space": "command_palette::Toggle",
      "space t": "terminal_panel::ToggleFocus",
      "space h": "tab_switcher::Toggle",
      "space shift-n": "pane::ActivateNextItem",
      "space shift-p": "pane::ActivatePreviousItem",
    },
  },
  {
    // Agent prompts remain text inputs even when their editor uses Vim mode.
    "context": "MessageEditor > Editor",
    "bindings": {
      "space": null,
    },
  },
  // ============================================
  // Markdown preview
  // ============================================
  {
    "context": "MarkdownPreview",
    "bindings": {
      "-": "project_panel::ToggleFocus",
    },
  },
  // ============================================
  // Vim Normal mode
  // ============================================
  {
    "context": "Editor && mode == full && vim_mode == normal && !menu",
    "bindings": {
      "-": "project_panel::ToggleFocus",
      "space f .": "outline::Toggle",
      "space m p": "markdown::OpenPreview",
      // Remove search highlights
      "escape": "buffer_search::Dismiss",
      // LSP navigation
      "g d": "editor::GoToDefinition",
      "g r r": "editor::FindAllReferences",
      "g r i": "editor::GoToImplementation",
      "g r t": "editor::GoToTypeDefinition",
      "g r a": "editor::ToggleCodeActions",
      "g r n": "editor::Rename",
      "g l": "editor::Hover",
      "g shift-l": "diagnostics::Deploy",
      // Format
      "space r": "editor::Format",
      // Organize import
      "space c i": "editor::OrganizeImports",
      // Add blank line below/above (oo / OO)
      "o o": [
        "workspace::SendKeystrokes",
        "o escape"
      ],
      "shift-o shift-o": [
        "workspace::SendKeystrokes",
        "shift-o escape"
      ],
      // Copy from cursor to end (Y)
      "shift-y": [
        "workspace::SendKeystrokes",
        "y g $"
      ],
      // Join lines (preserve cursor) - J
      "shift-j": "vim::JoinLines",
      // Search UI approximates Neovim's substitute workflow
      "space s": "buffer_search::Deploy",
      "enter": ["workspace::SendKeystrokes", "i enter escape"],
      "ctrl-enter": ["workspace::SendKeystrokes", "escape o"],
      // Disable Q
      "shift-q": null,
      // Center after search
      "n": [
        "workspace::SendKeystrokes",
        "n z z"
      ],
      "shift-n": [
        "workspace::SendKeystrokes",
        "shift-n z z"
      ],
      // Git
      "space g g": "git::Diff",
      "space g h": "git::FileHistory",
      // Debug
      "space d s": "debugger::Start",
      "space d b": "editor::ToggleBreakpoint",
      "space d d": "debugger::StepOver",
      "space d i": "debugger::StepInto",
      "space d o": "debugger::StepOut",
      "space d r": "debugger::Restart",
      "space d t": "debugger::Stop",
      // Function/Class navigation
      "] m": "vim::NextMethodStart",
      "[ m": "vim::PreviousMethodStart",
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
    },
  },
  // ============================================
  // Vim Visual mode
  // ============================================
  {
    "context": "Editor && mode == full && vim_mode == visual && !menu",
    "bindings": {
      "shift-s": "vim::PushAddSurrounds",
      "g r a": "editor::ToggleCodeActions",
      // Move selected lines down (J)
      "shift-j": "editor::MoveLineDown",
      // Move selected lines up (K)
      "shift-k": "editor::MoveLineUp",
      // Stay in visual mode after indent
      "<": [
        "workspace::SendKeystrokes",
        "< g v"
      ],
      ">": [
        "workspace::SendKeystrokes",
        "> g v"
      ],
    },
  },
  // ============================================
  // Vim Insert mode
  // ============================================
  {
    "context": "Editor && mode == full && vim_mode == insert && !menu",
    "bindings": {
      // Jump to next line
      "ctrl-enter": [
        "workspace::SendKeystrokes",
        "escape o"
      ],
    },
  },
  // ============================================
  // Delete without replacing yanked text; leave operator-pending mappings intact
  // ============================================
  {
    "context": "Editor && mode == full && (vim_mode == normal || vim_mode == visual) && !menu",
    "bindings": {
      "d": ["workspace::SendKeystrokes", "\" _ d"],
      "shift-d": ["workspace::SendKeystrokes", "\" _ shift-d"],
      "x": ["workspace::SendKeystrokes", "\" _ x"],
    },
  },
  // ============================================
  // File panel (Project panel): Neo-tree-style bindings
  // ============================================
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "-": "workspace::ToggleLeftDock",
      "q": "workspace::ToggleLeftDock",
      "enter": "project_panel::OpenPermanent",
      // Open toggles directories; files use Zed's preview tab instead of a float.
      "shift-p": "project_panel::Open",
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "d": ["project_panel::Delete", { "skip_prompt": false }],
      "shift-t": ["project_panel::Trash", { "skip_prompt": false }],
      "r": "project_panel::Rename",
      "y": "project_panel::Copy",
      "x": "project_panel::Cut",
      "p": "project_panel::Paste",
      "s": "project_panel::OpenSplitVertical",
      "shift-s": "project_panel::OpenSplitHorizontal",
      // Zed opens a permanent tab, but may reuse an existing tab for this file.
      "t": "project_panel::OpenPermanent",
      "shift-c": "project_panel::CollapseSelectedEntry",
      "z": "project_panel::CollapseAllEntries",
      "backspace": "project_panel::SelectParent",
      "shift-h": "project_panel::ToggleHideHidden",
      "[ g": "project_panel::SelectPrevGitEntry",
      "] g": "project_panel::SelectNextGitEntry",
      // Remove conflicting netrw defaults: D deletes, R renames, o splits.
      "shift-d": null,
      "shift-r": null,
      "o": null,
      // Keep the existing hidden-file alias.
      "space e h": "project_panel::ToggleHideHidden",
      // / keeps Zed's directory content search. Neo-tree's tree filtering,
      // root changes (Backspace / .), and floating preview have no direct match.
    },
  },
  // ============================================
  // Picker/Search navigation
  // ============================================
  {
    "context": "Picker || BufferSearchBar || ProjectSearchBar",
    "bindings": {
      "ctrl-n": "menu::SelectNext",
      "ctrl-p": "menu::SelectPrevious",
    },
  },
]
