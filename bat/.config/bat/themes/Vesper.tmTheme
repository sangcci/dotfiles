      <key>lineHighlight</key><string>#161616</string>
      <key>gutterForeground</key><string>#505050</string>
    </dict></dict>
    <dict><key>scope</key><string>comment, punctuation.definition.comment</string><key>settings</key><dict><key>foreground</key><string>#707070</string><key>fontStyle</key><string>italic</string></dict></dict>
